
# ==========================================
# AI MODEL PROVIDERS (Adaptif & Universal)
# ==========================================
# 1. Alibaba Cloud ModelStudio (DashScope) - Default Universal
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here

# 2. OpenAI Original (Opsional, jika pakai GPT/O1)
OPENAI_API_KEY=sk-your_openai_api_key_here

# 3. Moonshot AI Original (Untuk Kimi langsung)
MOONSHOT_API_KEY=sk-your_moonshot_api_key_here

# 4. OpenRouter (Akses ratusan model dalam satu API)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ==========================================
# MCP SERVERS & TOOLS INTEGRATION
# ==========================================
# 5. Tavily Search (Web & News Research)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 6. Exa Search (Semantic & Code Search)
EXA_API_KEY=your_exa_api_key_here

# 7. Shodan (Cybersecurity & Network Reconnaissance)
SHODAN_API_KEY=your_shodan_api_key_here

# 8. GitHub (Repo management & DevOps)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here