{
  "$schema": "https://qwen-code.alibaba.com/schemas/settings.json",
  "env": {
    "DASHSCOPE_API_KEY": "YOUR_DASHSCOPE_API_KEY",
    "OPENAI_API_KEY": "YOUR_OPENAI_API_KEY",
    "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY",
    "EXA_API_KEY": "YOUR_EXA_API_KEY",
    "GITHUB_TOKEN": "YOUR_GITHUB_TOKEN"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${QWEN_PROJECT_DIR}/.qwen/hooks/prompt-router.js",
            "name": "prompt-router",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ${QWEN_PROJECT_DIR}/.qwen/hooks/security-check.js",
            "name": "security-check",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${QWEN_PROJECT_DIR}/.qwen/hooks/quality-gate.js",
            "name": "quality-gate",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node ${QWEN_PROJECT_DIR}/.qwen/hooks/auto-memory.js",
            "name": "auto-memory",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": [ "-y", "tavily-mcp@latest" ]
    },
    "exa": {
      "command": "npx",
      "args": [ "-y", "exa-mcp-server@latest" ]
    },
    "github": {
      "command": "npx",
      "args": [ "-y", "@modelcontextprotocol/server-github" ]
    },
    "filesystem": {
      "command": "npx",
      "args": [ "-y", "@modelcontextprotocol/server-filesystem", "./" ]
    },
    "fetch": {
      "command": "npx",
      "args": [ "-y", "@kazuph/mcp-fetch" ]
    },
    "memory": {
      "command": "npx",
      "args": [ "-y", "@modelcontextprotocol/server-memory" ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [ "-y", "@modelcontextprotocol/server-sequential-thinking" ]
    }
  }
}