{
  "$schema": "https://qwen-code.alibaba.com/schemas/settings.json",
  "ui": {
    "autoModeAcknowledged": true,
    "verbose": false,
    "expandToolCalls": false,
    "expandThinking": false
  },
  "$version": 4,
  "env": {
    "DASHSCOPE_API_KEY": "YOUR_DASHSCOPE_KEY",
    "TAVILY_API_KEY": "YOUR_TAVILY_KEY",
    "EXA_API_KEY": "YOUR_EXA_KEY",
    "BRAVE_API_KEY": "YOUR_BRAVE_KEY",
    "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY",
    "GEMINI_API_KEY": "YOUR_GEMINI_KEY",
    "GITHUB_TOKEN": "YOUR_GITHUB_PAT",
    "BAILIAN_TOKEN_PLAN_API_KEY": "YOUR_TOKEN_PLAN_KEY"
  },
  "model": {
    "name": "qwen3.7-plus",
    "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "kimi-k2.7-code",
        "name": "kimi-k2.7-code",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "envKey": "DASHSCOPE_API_KEY"
      },
      {
        "id": "qwen3.7-plus",
        "name": "[ModelStudio Standard] qwen3.7-plus",
        "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "envKey": "DASHSCOPE_API_KEY",
        "generationConfig": {
          "extra_body": { "enable_thinking": true },
          "contextWindowSize": 1000000
        }
      },
      {
        "id": "qwen3.7-max",
        "name": "[ModelStudio Standard] qwen3.7-max",
        "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "envKey": "DASHSCOPE_API_KEY",
        "generationConfig": {
          "extra_body": { "enable_thinking": true },
          "contextWindowSize": 1000000
        }
      },
      {
        "id": "qwen3.8-max-preview",
        "name": "[ModelStudio Token Plan] qwen3.8-max-preview",
        "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY",
        "generationConfig": {
          "extra_body": { "enable_thinking": true },
          "thinkingMandatory": true,
          "contextWindowSize": 1000000,
          "modalities": { "image": true, "video": true }
        }
      },
      {
        "id": "deepseek-v4-pro",
        "name": "[ModelStudio Token Plan] deepseek-v4-pro",
        "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY",
        "generationConfig": { "contextWindowSize": 1000000 }
      }
    ],
    "gemini": [
      {
        "id": "gemini-3.5-flash",
        "name": "gemini-3.5-flash",
        "baseUrl": "https://generativelanguage.googleapis.com",
        "envKey": "GEMINI_API_KEY",
        "generationConfig": {
          "extra_body": { "enable_thinking": true },
          "modalities": { "image": true, "video": true }
        }
      }
    ]
  },
  "permissions": {
    "allow": ["read_file", "grep_search", "glob", "list_directory", "mcp__tavily__tavily_search"],
    "ask": ["write_file", "edit_file", "run_shell_command"],
    "deny": ["rm -rf", "git push --force", "curl* | sh", "> /dev/sda"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/session-bootstrap.js",
            "name": "session-bootstrap",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/prompt-router.js",
            "name": "prompt-router",
            "timeout": 15000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/subagent-presenter.js",
            "name": "subagent-presenter",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/security-check.js",
            "name": "security-check",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/trading-risk-guard.js",
            "name": "trading-risk-guard",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/lint-check.js",
            "name": "lint-check",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/auto-format.js",
            "name": "auto-format",
            "timeout": 5000
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/parent-silencer.js",
            "name": "parent-silencer",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/output-sanitizer.js",
            "name": "output-sanitizer",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/quality-gate.js",
            "name": "quality-gate",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/auto-memory.js",
            "name": "auto-memory",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/improvement-tracker.js",
            "name": "improvement-tracker",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node __QWEN_HOME__/hooks/protocol-updater.js",
            "name": "protocol-updater",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python __QWEN_HOME__/core/memory-distiller.py",
            "name": "memory-distiller",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "description": "Real-time web search optimized for AI"
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server@latest"],
      "description": "Semantic search for code and research"
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "description": "Privacy-focused web search (2000 free queries/month)"
    },
    "web-research": {
      "command": "npx",
      "args": ["-y", "@mzxrai/mcp-webresearch@latest"],
      "description": "Automated deep web research"
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@kazuph/mcp-fetch"],
      "description": "Raw URL content retrieval"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "description": "Local filesystem access"
    }
  },
  "security": {
    "auth": { "selectedType": "gemini" }
  }
}